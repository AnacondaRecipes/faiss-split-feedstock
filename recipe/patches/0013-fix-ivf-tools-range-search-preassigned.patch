From 6f8c7a0c7f6c2f2a63ccf35fb99e013a3a9f5dbe Mon Sep 17 00:00:00 2001
From: Xianglong Kong <xkong@anaconda.com>
Date: Sat, 8 Nov 2025 18:05:00 -0600
Subject: [PATCH] Ensure IVF contrib helpers pass contiguous buffers

Use the existing Python range_search_preassigned wrapper instead of
calling the low-level SWIG binding directly. The wrapper ensures
contiguous buffers, correct NumPy dtypes and radius conversion.

Refreshed for FAISS v1.16.0.
---

diff --git a/contrib/ivf_tools.py b/contrib/ivf_tools.py
index 22a0700..d9ed4f6 100644
--- a/contrib/ivf_tools.py
+++ b/contrib/ivf_tools.py
@@ -70,18 +70,7 @@ def range_search_preassigned(index_ivf, x, radius, list_nos, coarse_dis=None):
     else:
         assert coarse_dis.shape == (n, index_ivf.nprobe)
 
-    res = faiss.RangeSearchResult(n)
-    sp = faiss.swig_ptr
-
-    index_ivf.range_search_preassigned_c(
-        n, sp(x), radius, sp(list_nos), sp(coarse_dis), res
-    )
-    # get pointers and copy them
-    lims = faiss.rev_swig_ptr(res.lims, n + 1).copy()
-    num_results = int(lims[-1])
-    dist = faiss.rev_swig_ptr(res.distances, num_results).copy()
-    indices = faiss.rev_swig_ptr(res.labels, num_results).copy()
-    return lims, dist, indices
+    return index_ivf.range_search_preassigned(x, radius, list_nos, coarse_dis)
 
 
 def replace_ivf_quantizer(index_ivf, new_quantizer):
